# All optional. Nothing here is fabricated — leave unset until the client
# provides real values, and the corresponding feature stays inactive.

# Production domain, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.lifelineambulanceservice.in

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Only loads after a visitor
# accepts analytics cookies in the consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion ID (e.g. AW-XXXXXXXXX). Only loads after a visitor
# accepts advertising cookies in the consent banner.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Ads click-to-call conversion label (e.g. AW-XXXXXXXXX/AbCdEfGhIj),
# from a Phone Call conversion action in the Ads account. Fires alongside
# every tel: link click once set.
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_LABEL=

# Google Search Console HTML-tag verification code (the "content" value
# from the meta tag Search Console gives you).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
